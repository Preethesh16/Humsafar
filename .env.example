PRAVA_BASE_URL=https://sandbox.api.prava.space
# Backend-only Bearer credential (`sk_test_...`). Never expose to Vite/browser code.
PRAVA_SECRET_KEY=
# Client SDK credential (`pk_test_...`). Reserved for the future browser SDK step.
PRAVA_PUBLISHABLE_KEY=
PRAVA_REQUEST_TIMEOUT_MS=10000
# Stable ID from our app; Prava creates/associates it during the first session.
PRAVA_TEST_CUSTOMER_ID=humsafar-demo-user
PRAVA_TEST_CUSTOMER_EMAIL=
PRAVA_TEST_MANDATE_AMOUNT_CAP=100
PRAVA_TEST_MERCHANT_NAME=Duffel
PRAVA_TEST_MERCHANT_URL=https://duffel.com
PRAVA_TEST_MERCHANT_COUNTRY=GB
PRAVA_TEST_PRODUCT_DESCRIPTION=Humsafar cap enforcement proof
PRAVA_MANDATE_MERCHANTS_JSON={}
HOST=127.0.0.1
PORT=3000
INTERNAL_API_TOKEN=
DUFFEL_ACCESS_TOKEN=
PUBLIC_BASE_URL=http://127.0.0.1:3000
