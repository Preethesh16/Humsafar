{
  "name": "humsafar-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --network-family-autoselection-attempt-timeout=2000 backend/src/server.js",
    "start:sandbox": "node --network-family-autoselection-attempt-timeout=2000 --env-file=.env backend/src/server.js",
    "prava:verify": "node --network-family-autoselection-attempt-timeout=2000 --env-file=.env backend/scripts/verifyPravaAccess.js",
    "prava:create-mandate-session": "node --network-family-autoselection-attempt-timeout=2000 --env-file=.env backend/scripts/createPravaMandateSession.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
