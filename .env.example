PRAVA_BASE_URL=https://sandbox.api.prava.space
# Backend-only Bearer credential (`sk_test_...`). Never expose to Vite/browser code.
PRAVA_SECRET_KEY=
# Client SDK credential (`pk_test_...`). Reserved for the future browser SDK step.
PRAVA_PUBLISHABLE_KEY=
PRAVA_REQUEST_TIMEOUT_MS=10000
# Stable ID from our app; Prava creates/associates it during the first session.
PRAVA_TEST_CUSTOMER_ID=humsafar-demo-user
PRAVA_TEST_CUSTOMER_EMAIL=
PRAVA_TEST_MANDATE_AMOUNT_CAP=100
PRAVA_TEST_MERCHANT_NAME=Duffel
PRAVA_TEST_MERCHANT_URL=https://duffel.com
PRAVA_TEST_MERCHANT_COUNTRY=GB
PRAVA_TEST_PRODUCT_DESCRIPTION=Humsafar cap enforcement proof
PRAVA_MANDATE_MERCHANTS_JSON={}
HOST=127.0.0.1
PORT=3000
INTERNAL_API_TOKEN=
DUFFEL_ACCESS_TOKEN=
# Server-only key with the Geocoding API enabled. It converts a destination
# name to coordinates for Duffel Stays; it is never sent to the browser.
GOOGLE_MAPS_API_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:3000

# --- Agent core (Jeswin) -----------------------------------------------------
# All optional. With OPENAI_API_KEY unset the agent core runs end to end on the
# deterministic path: identical allocations and purchases, templated dialogue
# instead of model dialogue. Read by agents/humsafar/config.py.
OPENAI_API_KEY=
HUMSAFAR_SPECIALIST_MODEL=gpt-4.1-nano
# Used for goal parsing and the mediator's explanation. Keep a model this
# account is confirmed to serve; smoke-check any newer target before making it
# the demo default.
HUMSAFAR_REASONING_MODEL=gpt-5.6-sol
HUMSAFAR_AGENT_TIMEOUT=12
HUMSAFAR_BACKEND_URL=http://127.0.0.1:3000
# Browser runs use provider discovery and human approval/choice by default.
# These two flags are intentionally opt-in because enabling them can consume a
# real Prava sandbox mandate. Never enable live checkout without a real merchant
# processor integration that can report the actual result.
HUMSAFAR_LIVE_CARDS=false
HUMSAFAR_LIVE_CHECKOUT=false

# Keep model and tool payloads out of OpenAI traces. A trace may show which
# agent spoke and when; it must never carry a key, card token, CVV, expiry or a
# raw Prava response.
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=0
OPENAI_AGENTS_DONT_LOG_MODEL_DATA=1
OPENAI_AGENTS_DONT_LOG_TOOL_DATA=1
