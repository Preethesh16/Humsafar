PRAVA_BASE_URL=https://sandbox.api.prava.space
# Backend-only Bearer credential (`sk_test_...`). Never expose to Vite/browser code.
PRAVA_SECRET_KEY=
# Client SDK credential (`pk_test_...`). Reserved for the future browser SDK step.
PRAVA_PUBLISHABLE_KEY=
PRAVA_REQUEST_TIMEOUT_MS=10000
# Stable ID from our app; Prava creates/associates it during the first session.
PRAVA_TEST_CUSTOMER_ID=humsafar-demo-user
PRAVA_TEST_CUSTOMER_EMAIL=
PRAVA_TEST_MANDATE_AMOUNT_CAP=100
PRAVA_TEST_MERCHANT_NAME=Duffel
PRAVA_TEST_MERCHANT_URL=https://duffel.com
PRAVA_TEST_MERCHANT_COUNTRY=GB
PRAVA_TEST_PRODUCT_DESCRIPTION=Humsafar cap enforcement proof
# Explicit opt-in: lets a signed browser session create a server-pinned,
# trip-total Prava mandate-setup URL for the inline phone QR. This authorizes a
# capped budget only; it does not create credentials, charge or book anything.
HUMSAFAR_ENABLE_PRAVA_PHONE_APPROVAL=false
PRAVA_PHONE_MERCHANT_NAME=Humsafar
PRAVA_PHONE_MERCHANT_URL=https://github.com/Preethesh16/Humsafar
PRAVA_PHONE_MERCHANT_COUNTRY=IN
PRAVA_PHONE_PRODUCT_DESCRIPTION=Humsafar sandbox trip plan
PRAVA_MANDATE_MERCHANTS_JSON={}
HOST=127.0.0.1
PORT=3000
INTERNAL_API_TOKEN=
# Signs the browser session cookie that replaces the Vite dev proxy once
# deployed (see backend/src/session.js). Generated per boot when unset, so a
# restart logs everyone out — set it for a stable demo. Never expose it.
SESSION_SECRET=
DUFFEL_ACCESS_TOKEN=
# Keyless daily reference rates used only when provider search inventory is not
# denominated in INR. These are planning conversions, never settlement quotes.
FX_BASE_URL=https://api.frankfurter.dev
# Backend-only key used for destination geocoding, real POI discovery, nearby
# food suggestions, and route duration/distance. Never expose it with VITE_.
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com
# Keyless weather forecasts. Exact-date forecasts are only shown inside the
# provider's supported 16-day window; distant trips are never given fake weather.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# Optional paid geocoder override. When absent, Humsafar uses low-volume,
# cached OpenStreetMap Nominatim geocoding with no key. It is never sent to the browser.
GOOGLE_MAPS_API_KEY=
# Needs BOTH "Geocoding API" and "Places API" enabled on the key. Geocoding
# alone resolves the destination for stay search; Places is what turns a map
# link from a search list into a pin on the exact venue.
HUMSAFAR_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Must identify this deployment. Public Nominatim allows at most 1 request/sec;
# for scale, point the URL above at a self-hosted instance.
HUMSAFAR_NOMINATIM_USER_AGENT=Humsafar/0.1 (+https://github.com/Preethesh16/Humsafar)
PUBLIC_BASE_URL=http://127.0.0.1:3000

# --- Agent core (Jeswin) -----------------------------------------------------
# All optional. With OPENAI_API_KEY unset the agent core runs end to end on the
# deterministic path: identical allocations and purchases, templated dialogue
# instead of model dialogue. Read by agents/humsafar/config.py.
OPENAI_API_KEY=
HUMSAFAR_SPECIALIST_MODEL=gpt-4.1-nano
# Used for goal parsing and the mediator's explanation. Keep a model this
# account is confirmed to serve; smoke-check any newer target before making it
# the demo default.
HUMSAFAR_REASONING_MODEL=gpt-5.6-sol
HUMSAFAR_AGENT_TIMEOUT=12
HUMSAFAR_BACKEND_URL=http://127.0.0.1:3000
# Command resolved relative to the `agents/` child-process working directory.
# Use `.venv/bin/python` after creating `agents/.venv` on PEP 668 systems.
HUMSAFAR_PYTHON=python3
# Browser runs use provider discovery and human approval/choice by default.
# These two flags are intentionally opt-in because enabling them can consume a
# real Prava sandbox mandate. Never enable live checkout without a real merchant
# processor integration that can report the actual result.
HUMSAFAR_LIVE_CARDS=false
HUMSAFAR_LIVE_CHECKOUT=false

# Keep model and tool payloads out of OpenAI traces. A trace may show which
# agent spoke and when; it must never carry a key, card token, CVV, expiry or a
# raw Prava response.
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=0
OPENAI_AGENTS_DONT_LOG_MODEL_DATA=1
OPENAI_AGENTS_DONT_LOG_TOOL_DATA=1
